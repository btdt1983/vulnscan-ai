[Unit]
Description=vulnscan-ai scheduled vulnerability scan and report
Documentation=man:vulnscan-ai(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# API keys / overrides live here (0640 root). Optional: a scan-only run
# (no --plan) needs no key and sends nothing off the host.
EnvironmentFile=-/etc/vulnscan-ai/vulnscan-ai.env
ExecStart=/usr/bin/vulnscan-ai scheduled --keep 30
# Explicit and generous, not systemd's ~90s default: with the network
# scanner enabled, one scan can run TWO nmap invocations (IPv4 + IPv6, each
# capped by network_scan_timeout, default 900s each) on top of every other
# scanner, so the default DefaultTimeoutStartSec would kill a legitimate
# scan mid-run.
TimeoutStartSec=3600

# Be a good neighbour on production hosts.
Nice=10
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

# Hardening (scan-only job; the interactive `fix` apply is never run here).
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/vulnscan-ai /var/cache/dnf /var/cache/PackageKit
